# -----------------------------------------------------------------------------
# B1: API runtime
# -----------------------------------------------------------------------------
APP_ENV=local
SERVICE_NAME=tauco-api
HTTP_HOST=127.0.0.1
PORT=8080
# HTTP_PORT is a backward-compatible fallback when PORT is not set.
# HTTP_PORT=8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_GRACE_PERIOD=10s
LOG_LEVEL=info
LOG_FORMAT=console

# -----------------------------------------------------------------------------
# Local Docker Compose dependencies
# These values are local-only examples, not production credentials.
# -----------------------------------------------------------------------------
TAUCO_POSTGRES_DB=tauco
TAUCO_POSTGRES_USER=tauco_app
TAUCO_POSTGRES_PASSWORD=tauco-local-postgres-only
TAUCO_POSTGRES_PORT=5432

TAUCO_REDIS_PASSWORD=tauco-local-redis-only
TAUCO_REDIS_PORT=6379

TAUCO_MAILPIT_SMTP_PORT=1025
TAUCO_MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# B3 PostgreSQL migration, seed, and runtime connection policy
# -----------------------------------------------------------------------------
# The local Compose bootstrap/migration owner is never an application runtime
# credential. Role bootstrap is enabled only for local/owned PostgreSQL.
MIGRATION_DATABASE_URL=postgres://tauco_app:tauco-local-postgres-only@127.0.0.1:5432/tauco?sslmode=disable
MIGRATION_BOOTSTRAP_ROLES=true
DATABASE_URL=postgres://tauco_app_runtime:tauco-local-runtime-only@127.0.0.1:5432/tauco?sslmode=disable
ADMIN_DATABASE_URL=postgres://tauco_admin_local:tauco-local-admin-runtime-only@127.0.0.1:5432/tauco?sslmode=disable
DATABASE_DEPLOYMENT_PROFILE=owned
# D3 only: keep PROVISION_DATABASE_URL in backend/.env or the operator shell,
# run `npm.cmd run backend:provision`, then remove it immediately.
# PROVISION_DATABASE_URL=
JWT_PRIVATE_KEY_FILE=.local-auth/jwt-private.pem
JWT_PUBLIC_KEY_FILE=.local-auth/jwt-public.pem
JWT_KEY_ID=local-2026-08
JWT_ISSUER=tauco-api
JWT_AUDIENCE=tauco-admin
# Production/staging tidak membaca file RSA. Generate satu kali dengan
# `npm.cmd run backend:admin -- keygen-ed25519`, lalu simpan output sebagai
# secret provider `JWT_ED25519_PRIVATE_KEY_BASE64`.
# JWT_ED25519_PRIVATE_KEY_BASE64=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('base64').replace(/=+$/, ''))"
MFA_ENCRYPTION_KEY=replace-with-raw-base64-32-byte-key
MFA_ENCRYPTION_KEY_ID=local-2026-08
RECOVERY_CODE_HMAC_SECRET=tauco-local-recovery-code-secret-change-me
ADMIN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_COOKIE_SECURE=false
ADMIN_REMOTE_ENABLED=true
ADMIN_BFF_SHARED_SECRET=tauco-local-admin-bff-secret-change-me
CONTACT_API_ENABLED=true
FORM_SYNC_ENABLED=false
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
CURSOR_HMAC_SECRET=tauco-local-cursor-secret-change-me
CONTACT_HMAC_SECRET=tauco-local-contact-secret-change-me
RATE_LIMIT_HMAC_SECRET=tauco-local-rate-limit-secret-change-me
METRICS_BEARER_TOKEN=tauco-local-metrics-token-change-me

REDIS_URL=redis://:tauco-local-redis-only@127.0.0.1:6379/0

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=dev-no-reply@tauco.local
SMTP_TO=owner@example.com

# Local remains the default development adapter. Staging/production requires
# the private S3-compatible bucket values below; never expose these to Next.js.
MEDIA_LOCAL_ROOT=.local-media
MEDIA_STORAGE_DRIVER=local
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=
MEDIA_S3_BUCKET=
MEDIA_S3_PREFIX=tauco
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUSTED_PROXY_CIDRS=

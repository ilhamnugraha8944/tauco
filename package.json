    "lighthouse": "^12.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "^8.5.12",
    "sharp": "$sharp"
  }
}

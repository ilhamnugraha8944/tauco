{
  "name": "tauco-cap-badak-web",
  "version": "0.1.0",
  "private": true,
  "description": "Website publik SEO-first Tauco Cap Badak Cianjur.",
  "engines": {
    "node": ">=22.0.0 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:e2e": "npm run build && node scripts/run-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:admin": "node scripts/run-admin-e2e.mjs",
    "qa:g4:functional": "node scripts/run-e2e.mjs --config=playwright.g4.config.ts tests/e2e/g4-functional.spec.ts --project=chromium-desktop",
    "qa:g4:seo": "node scripts/run-e2e.mjs --config=playwright.g4.config.ts tests/e2e/g4-seo.spec.ts --project=chromium-desktop",
    "qa:g4:form": "node scripts/run-e2e.mjs --config=playwright.g4.config.ts tests/e2e/g4-form.spec.ts --project=chromium-desktop",
    "qa:g4:form:live": "node scripts/run-e2e.mjs --config=playwright.g4.config.ts tests/e2e/g4-form.spec.ts --project=chromium-desktop --grep \"live Netlify Forms\" --workers=1",
    "qa:g4:a11y": "node scripts/run-e2e.mjs --config=playwright.g4.config.ts tests/e2e/quality.spec.ts tests/e2e/site.spec.ts --project=chromium-desktop --grep \"has no WCAG A or AA axe violations|public pages do not overflow|responsive boundaries preserve navigation and hero hierarchy|dark mode keeps every public route axe-clean|dynamic contact states remain axe-clean|focus remains visible and reduced motion shortens transitions|keyboard-only walkthrough reaches every visible control|mobile menu opens and closes with keyboard while retaining focus|shows inline validation errors and focuses the first invalid field\"",
    "qa:g4:browsers": "node scripts/run-e2e.mjs --config=playwright.g4-browsers.config.ts tests/e2e/g4-browser.spec.ts",
    "qa:g4": "node scripts/run-g4-qa.mjs",
    "qa:g6": "node scripts/run-production-qa.mjs --config=playwright.production.config.ts tests/e2e/g6-production.spec.ts",
    "qa:g7:form:live": "node scripts/run-production-qa.mjs --config=playwright.production.config.ts tests/e2e/g7-production-form.spec.ts --workers=1 --retries=0",
    "images:optimize": "node scripts/optimize-images.mjs",
    "walkthrough:capture": "npm run build && node scripts/capture-walkthrough.mjs",
    "plan:pdf": "node scripts/generate-plan-pdf.mjs",
    "backend:docs:pdf": "node scripts/generate-plan-pdf.mjs BACKEND_CODE_DOCUMENTATION.md BACKEND_CODE_DOCUMENTATION.pdf backend",
    "lighthouse": "node scripts/run-lighthouse.mjs",
    "lighthouse:production": "node scripts/run-production-lighthouse.mjs",
    "backend:dev": "node scripts/run-backend-db.mjs api",
    "backend:admin": "node scripts/run-backend-db.mjs admin",
    "backend:worker": "node scripts/run-backend-db.mjs worker",
    "backend:worker:ready": "node scripts/run-backend-db.mjs worker --check",
    "backend:worker:once": "node scripts/run-backend-db.mjs worker --once",
    "backend:worker:cleanup-media": "node scripts/run-backend-db.mjs worker --cleanup-media",
    "backend:media:import": "node scripts/run-backend-db.mjs media-import",
    "backend:ops": "node scripts/run-backend-db.mjs ops",
    "backend:load": "node scripts/run-backend-db.mjs loadcheck",
    "backend:migrate": "node scripts/run-backend-db.mjs migrate",
    "backend:migrate:up": "node scripts/run-backend-db.mjs migrate up",
    "backend:migrate:version": "node scripts/run-backend-db.mjs migrate version",
    "backend:migrate:down": "node scripts/run-backend-db.mjs migrate down",
    "backend:provision": "node scripts/run-backend-db.mjs provision",
    "backend:seed:phase1a": "node scripts/run-backend-db.mjs seed-phase1a",
    "backend:format": "node scripts/run-backend-go.mjs fmt ./...",
    "backend:format:check": "node scripts/check-go-format.mjs",
    "backend:generate": "node scripts/run-backend-go.mjs tool oapi-codegen --config openapi/oapi-codegen.yaml openapi/openapi.yaml",
    "backend:generate:check": "node scripts/check-openapi-generated.mjs",
    "backend:test": "node scripts/run-go-tests.mjs",
    "backend:test:integration": "node scripts/run-backend-db.mjs integration",
    "backend:race": "node scripts/run-backend-race.mjs",
    "backend:vet": "node scripts/run-backend-go.mjs vet ./...",
    "backend:lint": "node scripts/run-backend-lint.mjs",
    "backend:vuln": "node scripts/run-backend-vuln.mjs",
    "backend:build": "node scripts/run-backend-go.mjs build ./cmd/...",
    "backend:container:build": "docker build -t tauco-api:phase1b-local backend",
    "backend:check": "npm run backend:generate:check && npm run backend:test && npm run backend:test:integration && npm run backend:vet && npm run backend:build",
    "backend:quality": "npm run backend:format:check && npm run backend:check && npm run backend:race && npm run backend:lint && npm run backend:vuln && npm run backend:load && npm run backend:container:build",
    "phase1b:quality": "npm run backend:quality && npm run check:frontend && npm run test:e2e && npm run qa:g6",
    "backend:compose:up": "docker compose -f backend/compose.yaml --profile mail up -d --wait",
    "backend:compose:down": "docker compose -f backend/compose.yaml down",
    "check:frontend": "npm run lint && npm run typecheck && npm run build",
    "check": "npm run check:frontend && npm run backend:check"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "next": "^16.2.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.11",
    "lighthouse": "^12.6.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "$sharp"
  }
}

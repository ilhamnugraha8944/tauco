# Origin canonical untuk development local.
# Production nanti wajib diisi melalui environment hosting, bukan file ini.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opsional. Isi setelah properti tersedia di Google Search Console.
GOOGLE_SITE_VERIFICATION=

# Phase 1C local shadow-mode. Tetap false pada production Phase 1A.
ADMIN_CMS_ENABLED=false
ADMIN_API_ORIGIN=http://127.0.0.1:8080
ADMIN_REMOTE_ENABLED=false
# Server-only; samakan dengan backend dan jangan pernah memakai prefix NEXT_PUBLIC_.
ADMIN_BFF_SHARED_SECRET=
